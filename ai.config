# めざめ 記事生成に使うモデル
# 環境変数に同じ名前があれば、そちらが優先されます。
# 秘密の情報は書かないこと（APIキーは .openai_key か環境変数 OPENAI_API_KEY）。

# ふだんの記事生成・リサーチ・リライト
ARTICLE_MODEL=gpt-5.6-luna

# 仕上げの編集、構成の判断
EDITOR_MODEL=gpt-5.6-terra

# とくに難しい構成判断のときだけ（2026-09-10: 高いので使わない。運営者の指示）
PREMIUM_MODEL=gpt-5.6-sol

# いまある記事の書き直し（scripts/polish.py）
POLISH_MODEL=gpt-5.6-terra
